<?xml version="1.0" ?>
<!-- 
  Gazebo World File for Water Sampling Simulation
  
  This world includes:
  - Lake/reservoir water body
  - Realistic terrain
  - Environmental elements
  - Spawn point for drone
  
  Usage: gazebo --verbose gazebo_world.sdf
-->
<sdf version="1.6">
  <world name="water_sampling_world">
    
    <!-- Physics settings -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <gravity>0 0 -9.81</gravity>
    </physics>
    
    <!-- Scene lighting and environment -->
    <scene>
      <ambient>0.5 0.5 0.5 1.0</ambient>
      <background>0.5 0.7 1.0 1.0</background>
      <shadows>true</shadows>
      <sky>
        <clouds>
          <speed>0.15</speed>
        </clouds>
      </sky>
    </scene>
    
    <!-- Sun -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    
    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.3 0.5 0.3 1</ambient>
            <diffuse>0.3 0.5 0.3 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Water body (lake) -->
    <model name="lake">
      <static>true</static>
      <pose>0 0 -0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>100 100 1</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.1</mu>
                <mu2>0.1</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>100 100 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.0 0.3 0.6 0.8</ambient>
            <diffuse>0.0 0.4 0.7 0.8</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
            <emissive>0 0 0 0</emissive>
          </material>
          <transparency>0.2</transparency>
        </visual>
      </link>
    </model>
    
    <!-- Trees around lake -->
    <model name="tree_1">
      <static>true</static>
      <pose>-20 -20 0 0 0 0</pose>
      <link name="link">
        <!-- Trunk -->
        <visual name="trunk">
          <geometry>
            <cylinder>
              <radius>0.5</radius>
              <length>5</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.4 0.25 0.1 1</ambient>
            <diffuse>0.5 0.3 0.15 1</diffuse>
          </material>
        </visual>
        <!-- Foliage -->
        <visual name="foliage">
          <pose>0 0 4 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>3</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.1 0.4 0.1 1</ambient>
            <diffuse>0.2 0.6 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Additional trees (repeat with different poses) -->
    <include>
      <uri>model://tree_1</uri>
      <pose>20 -15 0 0 0 0.5</pose>
    </include>
    
    <include>
      <uri>model://tree_1</uri>
      <pose>-15 20 0 0 0 1.2</pose>
    </include>
    
    <!-- Drone launch pad -->
    <model name="launch_pad">
      <static>true</static>
      <pose>10 10 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>3 3 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0.5 0 1</ambient>
            <diffuse>1 0.6 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Wind simulation -->
    <wind>
      <linear_velocity>2.0 1.0 0.0</linear_velocity>
    </wind>
    
    <!-- Camera for visualization -->
    <gui>
      <camera name="user_camera">
        <pose>20 -20 15 0 0.5 2.35</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
    
    <!-- Plugin for ArduPilot SITL integration -->
    <plugin name="ardupilot_plugin" filename="libArduPilotPlugin.so">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <modelXYZToAirplaneXForwardZDown>0 0 0 3.141593 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED>0 0 0 3.141593 0 0</gazeboXYZToNED>
    </plugin>
    
  </world>
</sdf>
